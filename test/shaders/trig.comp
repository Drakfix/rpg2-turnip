#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0) buffer B { float d[]; };
void main()
{
   uint i = gl_GlobalInvocationID.x;
   float x = d[i];
   /* even slots get sin(x), odd slots cos(x); the host fills pairs with the same x */
   d[i] = (i & 1u) == 0u ? sin(x) : cos(x);
}
