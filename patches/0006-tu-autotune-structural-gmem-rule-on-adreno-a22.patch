+/* RPG2: the "structural" GMEM/SYSMEM rule, made for the Adreno A22 (Retroid
+ * Pocket G2, chip id 0x43030b00) where it is the default.
+ *
+ * GMEM only pays for itself when the render pass keeps data in tile memory
+ * that SYSMEM would have to write out and read back:
+ *  - several subpasses: earlier subpasses' outputs (G-buffers, input
+ *    attachments) stay on chip instead of a full-size write + read in memory;
+ *  - a resolve attachment that is actually used: GMEM resolves while storing
+ *    each tile, SYSMEM needs a separate full-screen resolve of the MSAA image.
+ * Everything else uses SYSMEM, which on this GPU is up to ~2.5x faster for
+ * draw-heavy single-subpass RPs.
+ *
+ * The answer depends only on the render pass description, never on timings,
+ * draw counts or history, so the same RP gets the same mode every frame. That
+ * is the point: the profiled autotuner's random GMEM re-tries rendered some
+ * BOTW passes differently for single frames (terrain flicker, milky water).
+ *
+ * Input attachments alone are not a reason: Turnip's dynamic rendering always
+ * reports colorAttachmentCount + 1 of them (for local reads), and in a
+ * single-subpass legacy RP they are either a feedback loop (already sent to
+ * GMEM above via SINGLE_PRIM_MODE) or a plain read of memory that GMEM would
+ * have to load first. The same goes for resolve_count, which dynamic rendering
+ * sets to colorAttachmentCount, so only resolve attachments in use count.
+ *
+ * Returns the reason when GMEM is chosen, nullptr for SYSMEM.
+ */
+static const char *
+structural_gmem_reason(const struct tu_render_pass *pass)
+{
+   if (pass->subpass_count >= 2)
+      return "TU_AUTOTUNE_ALGO=structural: several subpasses";
+
+   for (uint32_t s = 0; s < pass->subpass_count; s++) {
+      const struct tu_subpass *subpass = &pass->subpasses[s];
+      if (!subpass->resolve_attachments)
+         continue;
+      for (uint32_t i = 0; i < subpass->resolve_count; i++) {
+         if (subpass->resolve_attachments[i].attachment != VK_ATTACHMENT_UNUSED)
+            return "TU_AUTOTUNE_ALGO=structural: resolve";
+      }
+   }
+   return nullptr;
+}
