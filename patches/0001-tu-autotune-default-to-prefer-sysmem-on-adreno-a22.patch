diff --git a/src/freedreno/vulkan/tu_autotune.cc b/src/freedreno/vulkan/tu_autotune.cc
index fd0b21f..294b32c 100644
--- a/src/freedreno/vulkan/tu_autotune.cc
+++ b/src/freedreno/vulkan/tu_autotune.cc
@@ -274,6 +274,22 @@ tu_autotune::get_env_config()
    static config_t at_config;
    std::call_once(once, [&] {
       algorithm algo = algorithm::DEFAULT;
+
+      /* RPG2: Adreno A22 (Snapdragon G2 Gen 2, KGSL chip id 0x43030b00).
+       * Measured on a Retroid Pocket G2: the bandwidth estimate picks GMEM for
+       * draw-call-heavy render passes that run ~2.5x faster in SYSMEM on this
+       * 3-CCU GPU. The profiled algorithm finds the faster mode but keeps
+       * re-trying the other one at random (>= 1% per pass), and in Zelda BOTW
+       * (Eden) those occasional GMEM frames render terrain differently: one-frame
+       * flashes of ~700 16x16 blocks, 11 in 40 s, none with sysmem or bandwidth.
+       * prefer_sysmem never flips and cost no GPU time in BOTW (11.8-12.6 vs
+       * 12.8 Mcycles/frame for profiled, 12.5-12.6 for bandwidth).
+       * Still overridable with TU_AUTOTUNE_ALGO (debug.mesa.tu.autotune.algo
+       * on Android) or the tu_autotune_algorithm driconf option.
+       */
+      if ((device->physical_device->dev_id.chip_id & 0xffffffffull) == 0x43030b00ull)
+         algo = algorithm::PREFER_SYSMEM;
+
       const char *algo_str = os_get_option("TU_AUTOTUNE_ALGO");
       std::string_view algo_strv;
 
