+/* nir_opt_preamble hoists uniform computations (and UBO loads) out of the
+ * shader into the preamble, which runs once per draw/wave group and writes
+ * the results into the const file.
+ *
+ * RPG2: on the Adreno A22 (Snapdragon G2 Gen 2, chip id 0x43030b00) this costs
+ * more GPU time than it saves. In Zelda BOTW under Eden (Akkala Citadel, 30 FPS
+ * cap) GPU cycles per frame were 16.7 on average with the pass and 15.4 without
+ * it (IR3_SHADER_DEBUG=nopreamble, 4 vs 3 runs, -8%), matching the proprietary
+ * driver (15.3). Descriptor prefetch is kept: disabling it alone cost +9%.
+ * IR3_SHADER_DEBUG=optpreamble / nooptpreamble force the pass on / off.
+ */
+static bool
+ir3_use_opt_preamble(const struct ir3_compiler *compiler)
+{
+   if (ir3_shader_debug & IR3_DBG_OPTPREAMBLE)
+      return true;
+   if (ir3_shader_debug & IR3_DBG_NOOPTPREAMBLE)
+      return false;
+   if (compiler->dev_id &&
+       (compiler->dev_id->chip_id & 0xffffffffull) == 0x43030b00ull)
+      return false;
+   return true;
+}
+
 void
 ir3_nir_post_finalize(struct ir3_shader *shader)
 {
