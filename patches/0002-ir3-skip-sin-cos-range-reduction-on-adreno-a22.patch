     * we also need to do any run-once workarounds here:
     */
-   OPT(s, ir3_nir_apply_trig_workarounds);
+   if (ir3_needs_trig_workarounds(compiler))
+      OPT(s, ir3_nir_apply_trig_workarounds);
 
