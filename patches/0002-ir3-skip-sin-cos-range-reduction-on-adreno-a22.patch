 /**
  * Late passes that need to be done after pscreen->finalize_nir()
  */
+/* The trig workaround wraps every 32-bit sin/cos argument into [-pi, pi]
+ * before the native instruction (4 extra instructions per call).
+ *
+ * RPG2: on the Adreno A22 (Snapdragon G2 Gen 2, KGSL chip id 0x43030b00) the
+ * native sin/cos are accurate over the whole float range, and the proprietary
+ * driver (v762.31) uses them directly: with the workaround skipped, Turnip's
+ * output is bit-identical to the blob's over 262144 inputs (2^-30..2^60, +-0,
+ * +-inf, NaN, denormals), while with it applied the error grows with |x|
+ * (6e-5 at 1e3, 6e-3 at 1e5) and a sin/cos-heavy fragment shader runs ~17%
+ * slower. Measured on a Retroid Pocket G2, so only that chip id is exempted.
+ * IR3_SHADER_DEBUG=trigwa / notrigwa force it on / off for A/B testing.
+ */
+static bool
+ir3_needs_trig_workarounds(const struct ir3_compiler *compiler)
+{
+   if (ir3_shader_debug & IR3_DBG_TRIGWA)
+      return true;
+   if (ir3_shader_debug & IR3_DBG_NOTRIGWA)
+      return false;
+   if (compiler->dev_id &&
+       (compiler->dev_id->chip_id & 0xffffffffull) == 0x43030b00ull)
+      return false;
+   return true;
+}
+
 void
 ir3_nir_post_finalize(struct ir3_shader *shader)
 {
@@ -1111,7 +1136,8 @@ ir3_nir_post_finalize(struct ir3_shader *shader)
